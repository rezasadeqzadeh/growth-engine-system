# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/growth_engine
DATABASE_URL=
# 32+ random characters; the API refuses to start in production without it.
JWT_SECRET=
SUPERADMIN_PHONES=09xxxxxxxxx
# Where this service is reachable (tracked links, media URLs for Instagram, bot webhooks).
PUBLIC_BASE_URL=https://engine.example.ir
PANEL_URL=https://panel.example.ir

# OpenCode server: the only LLM provider. Models must be registered on that server.
OPENCODE_SERVER_URL=
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=
MODEL_STRONG=
MODEL_LIGHT=
MODEL_VISION=

# SMS sign-in codes (sms-webservice.com). Unset in development: the code is 0000.
SMS_WEBSERVICE_API_KEY=
SMS_SENDER=

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# Instagram API with Instagram Login (the Meta app). Redirect URI: <PUBLIC_BASE_URL>/api/instagram/callback
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=

# Media worker
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
# Optional: a local Telegram Bot API server for files over 20 MB.
TELEGRAM_API_BASE=
